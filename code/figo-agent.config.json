{
  "web": {
    "requireAccessCode": false,
    "fileBrowser": {
      "searchMinChars": 2,
      "searchMaxChars": 80,
      "maxVisitedDirectories": 200,
      "maxSearchResults": 100,
      "maxDirectoryEntries": 500,
      "maxPreviewBytes": 1048576,
      "maxReferenceLines": 200,
      "maxReferenceChars": 16000
    },
    "terminal": {
      "maxCommandChars": 4096,
      "historyEntries": 30,
      "maxOutputBytes": 131072,
      "timeoutMs": 120000
    }
  },
  "version": 2,
  "locale": "zh-CN",
  "llm": [
    {
      "id": "minimax",
      "enabled": true,
      "provider": "openai-compatible",
      "apiKey": "",
      "baseUrl": "https://api.minimaxi.com/v1",
      "model": "MiniMax-M3.1-Flash-Preview",
      "contextWindow": 1000000,
      "maxTokens": 524288,
      "maxTokensField": "max_completion_tokens",
      "metadataSource": "https://platform.minimax.cn/docs/api-reference/text-chat-openai"
    },
    {
      "id": "gpt-relay",
      "enabled": true,
      "provider": "openai-compatible",
      "toolCallingMode": "native",
      "apiKey": "",
      "baseUrl": "https://code.aicodeme.xyz/v1",
      "model": "gpt-6.1-sol",
      "contextWindow": 1050000,
      "maxTokens": 128000,
      "maxTokensField": "max_tokens",
      "metadataSource": "https://developers.openai.com/api/docs/models/gpt-6.1-sol"
    },
    {
      "id": "deepseek",
      "enabled": true,
      "provider": "openai-compatible",
      "apiKey": "",
      "baseUrl": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "contextWindow": 1048576,
      "maxTokens": 393216,
      "maxTokensField": "max_tokens",
      "metadataSource": "https://api-docs.deepseek.com/api/list-models/"
    }
  ],
  "agent": {
    "toolResultPreviewChars": 8000,
    "toolResultBatchChars": 12000,
    "protocolRepairAttempts": 1,
    "noProgressRepeatLimit": 2
  },
  "context": {
    "includeMemory": true,
    "compaction": {
      "enabled": true,
      "reserveTokens": 16384,
      "keepRecentTokens": 20000,
      "summaryToolResultMaxChars": 2000,
      "modelOverrides": {}
    }
  },
  "storage": {
    "sqliteBusyTimeoutMs": 5000
  },
  "tools": {
    "defaults": {
      "commandTimeoutMs": 30000,
      "commandMaxOutputBytes": 65536,
      "networkTimeoutMs": 30000,
      "networkMaxBytes": 131072,
      "browserMaxBytes": 262144,
      "gitTimeoutMs": 30000,
      "gitMaxOutputBytes": 131072,
      "gitLogCount": 5,
      "readManyMaxFiles": 20,
      "readManyMaxBytesPerFile": 65536,
      "readManyMaxTotalBytes": 262144,
      "workspaceSummaryMaxFiles": 200,
      "skillReadmeChars": 6000,
      "skillMatchCount": 10,
      "skillMatchChars": 160,
      "skillFileCount": 80
    },
    "allowed": [
      "list_files",
      "read_file",
      "search_text",
      "system_info",
      "path_stat",
      "read_many_files",
      "workspace_summary",
      "write_file",
      "apply_patch",
      "run_command",
      "git_status",
      "git_diff",
      "git_log",
      "git_add",
      "git_commit",
      "network_fetch",
      "browser_open",
      "browser_snapshot"
    ]
  },
  "activeModelId": "gpt-relay",
  "acceptance": {
    "piCompaction": {
      "timeoutMs": 180000,
      "pairRepetitions": 3,
      "testContextWindow": 49152,
      "stressContextWindow": 35440,
      "sourceSnapshotMinChars": 100000,
      "sourceChunkMaxChars": 16000,
      "scenarios": [
        "off",
        "auto-test-window"
      ]
    }
  }
}
