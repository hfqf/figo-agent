{
  "web": {
    "requireAccessCode": false,
    "fileBrowser": {
      "searchMinChars": 2,
      "searchMaxChars": 80,
      "maxVisitedDirectories": 200,
      "maxSearchResults": 100,
      "maxDirectoryEntries": 500,
      "maxPreviewBytes": 1048576,
      "maxReferenceLines": 200,
      "maxReferenceChars": 16000
    },
    "terminal": {
      "maxCommandChars": 4096,
      "historyEntries": 30,
      "maxOutputBytes": 131072,
      "timeoutMs": 120000
    }
  },
  "version": 2,
  "locale": "zh-CN",
  "llm": [
    {
      "id": "minimax",
      "enabled": true,
      "provider": "openai-compatible",
      "apiKey": "",
      "baseUrl": "https://api.minimaxi.com/v1",
      "model": "MiniMax-M3"
    },
    {
      "id": "gpt-relay",
      "enabled": true,
      "provider": "openai-compatible",
      "apiKey": "",
      "baseUrl": "https://code.aicodeme.xyz/v1",
      "model": "gpt-5.6-sol"
    }
  ],
  "agent": {
    "toolResultPreviewChars": 8000
  },
  "context": {
    "maxTaskHistoryTurns": 5,
    "includeMemory": true,
    "compaction": {
      "autoEnabled": true,
      "turnThreshold": 12,
      "charThreshold": 24000,
      "summaryMaxChars": 12000
    }
  },
  "tools": {
    "maxToolRounds": 3,
    "defaults": {
      "commandTimeoutMs": 30000,
      "commandMaxOutputBytes": 65536,
      "networkTimeoutMs": 30000,
      "networkMaxBytes": 131072,
      "browserMaxBytes": 262144,
      "gitTimeoutMs": 30000,
      "gitMaxOutputBytes": 131072,
      "gitLogCount": 5,
      "readManyMaxFiles": 20,
      "readManyMaxBytesPerFile": 65536,
      "readManyMaxTotalBytes": 262144,
      "workspaceSummaryMaxFiles": 200,
      "skillReadmeChars": 6000,
      "skillMatchCount": 10,
      "skillMatchChars": 160,
      "skillFileCount": 80,
      "toolTraceMaxChars": 16000
    },
    "allowed": [
      "list_files",
      "read_file",
      "search_text",
      "system_info",
      "path_stat",
      "read_many_files",
      "workspace_summary",
      "write_file",
      "apply_patch",
      "run_command",
      "git_status",
      "git_diff",
      "git_log",
      "git_add",
      "git_commit",
      "network_fetch",
      "browser_open",
      "browser_snapshot"
    ]
  },
  "activeModelId": "gpt-relay"
}
