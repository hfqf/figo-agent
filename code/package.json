{
  "name": "figo-agent",
  "version": "0.0.1-beta",
  "productName": "Figo Agent",
  "type": "module",
  "private": true,
  "main": "./dist/desktop/main.js",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "bin": {
    "figo-agent": "./dist/cli/main.js"
  },
  "scripts": {
    "assets:icons": "node scripts/build-icons.mjs",
    "assets:icons:win": "node scripts/build-windows-icon.mjs",
    "dev": "tsx src/cli/main.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "web:test:e2e": "tsx e2e/workbench.pw.ts",
    "web:test:tasks": "tsx e2e/task-sidebar.pw.ts",
    "web:test:tasks:regressions": "tsx e2e/task-sidebar-regressions.pw.ts",
    "web:test:trace": "tsx e2e/trace-inspector.pw.ts",
    "web:test:onboarding": "tsx e2e/onboarding.pw.ts",
    "web:demo:trace": "tsx e2e/trace-inspector-demo.ts",
    "web:dev": "npm run web:build && tsx src/ui/main.ts",
    "web:start": "tsx src/ui/main.ts",
    "desktop:dev": "npm run build && npm run web:build && node e2e/desktop-run.mjs",
    "desktop:package": "npm run build && npm run web:build && electron-forge package",
    "desktop:make": "npm run build && npm run web:build && electron-forge make",
    "desktop:make:win": "npm run build && npm run web:build && npm run assets:icons:win && electron-forge package --platform=win32 --arch=x64 && node e2e/desktop-windows-verify.mjs --app-only && electron-builder --config electron-builder.windows.cjs --win nsis --x64 --prepackaged \"out/Figo Agent-win32-x64\" --publish never && node e2e/desktop-windows-verify.mjs",
    "desktop:verify:win": "node e2e/desktop-windows-verify.mjs",
    "desktop:test:smoke": "npm run build && npm run web:build && node e2e/desktop-smoke.mjs",
    "desktop:test:e2e": "npm run build && npm run web:build && node e2e/desktop-workbench.pw.mjs",
    "desktop:test:e2e:package": "node e2e/desktop-package-run.mjs desktop-workbench.pw.mjs",
    "desktop:test:first-run": "npm run build && npm run web:build && node e2e/desktop-first-run.pw.mjs",
    "desktop:test:first-run:package": "node e2e/desktop-package-run.mjs desktop-first-run.pw.mjs",
    "desktop:test:active-exit": "npm run build && npm run web:build && node e2e/desktop-active-exit.pw.mjs",
    "desktop:test:active-exit:package": "node e2e/desktop-package-run.mjs desktop-active-exit.pw.mjs",
    "desktop:test:real": "npm run build && npm run web:build && node e2e/desktop-real-model.pw.mjs",
    "desktop:test:real:package": "node e2e/desktop-package-run.mjs desktop-real-model.pw.mjs",
    "desktop:test:dsml:package": "node e2e/desktop-package-run.mjs desktop-dsml.pw.mjs",
    "desktop:verify:package": "node e2e/desktop-package-verify.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.0",
    "png-to-ico": "3.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
